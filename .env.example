# URL pública do site (metadata, Open Graph, sitemap e URL do webhook do Mercado Pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ——— Mercado Pago ———
# Sem estas duas chaves o checkout roda em MODO DEMONSTRAÇÃO (nada é cobrado).
# Credenciais de TESTE: https://www.mercadopago.com.br/developers/panel/app → sua aplicação → Credenciais de teste
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=

# Chave secreta das notificações (Webhooks → Configurar notificações → "Assinatura secreta").
# O webhook só é registrado no pagamento quando NEXT_PUBLIC_SITE_URL é https (ex.: deploy ou túnel).
MP_WEBHOOK_SECRET=
