# Copie para .env.local e preencha. Nunca commite o .env.local.

# URL pública do site (metadata, Open Graph, links de e-mail do login e webhook do Mercado Pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ——— Supabase: banco (Prisma) ———
# Painel do projeto → botão "Connect" → ORMs → Prisma
# App (pooler de transação, porta 6543):
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrações e seed (conexão direta/sessão, porta 5432):
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ——— Supabase: autenticação ———
# Project Settings → API (ou API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# "publishable key" (sb_publishable_...) ou a antiga "anon key" — é pública por design
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA (sb_secret_...): só no servidor, nunca com NEXT_PUBLIC_. Usada apenas no upload de fotos do admin.
# Project Settings → API Keys → Secret keys. Sem ela, o painel aceita só caminhos /images/...
SUPABASE_SECRET_KEY=
# Mostra "continuar com Google" (ative o provedor Google no Supabase antes): on | off
NEXT_PUBLIC_AUTH_GOOGLE=off

# ——— Mercado Pago ———
# Sem estas duas chaves o checkout roda em MODO DEMONSTRAÇÃO (nada é cobrado).
# Credenciais de TESTE: https://www.mercadopago.com.br/developers/panel/app → sua aplicação → Credenciais de teste
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Webhooks → Configurar notificações → "Assinatura secreta"
MP_WEBHOOK_SECRET=

# ——— Paymento (pagamento em cripto) ———
# Sem estas duas chaves a opção "cripto" não aparece no checkout.
# Painel: https://app.paymento.io → Settings/API → API Key e Secret Key (a Secret assina as notificações IPN)
PAYMENTO_API_KEY=
PAYMENTO_SECRET_KEY=
# O valor vai em reais (BRL) e o cliente paga o equivalente em cripto, cotado pela Paymento na hora.
# Depois do deploy: pnpm paymento:setup https://SEU_DOMINIO  (registra /api/webhooks/paymento na Paymento)
